<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="np.ghar.home"
    android:versionCode="17"
    android:versionName="0.17">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="23" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- To show whether Bluetooth is switched on. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- Android 4.4: to see when the maker's home screen comes to the front, and take its place. -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/icon"
        android:theme="@style/Home"
        android:allowBackup="false">

        <!-- The TV board maker's own classes for switching inputs, on TVs that have them. -->
        <uses-library android:name="com.mstar.android" android:required="false" />

        <activity
            android:name=".HomeActivity"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:exported="true">
            <!-- Shows in the app list, so it can be opened like any app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Lets the TV offer it when the Home button is pressed. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- The phone remote and install-over-Wi-Fi server (port 8765, PIN shown on the TV). -->
        <service android:name=".LinkService" android:exported="false" />

        <!-- Starts the phone link and shows Ghar Home when the TV has started. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- A TV keyboard that also takes text from the phone remote. The user chooses it in the TV's settings. -->
        <service android:name=".GharKeyboard" android:label="@string/keyboard_name" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <!-- Lets the phone remote move, select and go back inside other apps. The user turns it on in the TV's settings. -->
        <service android:name=".GharAccess" android:label="@string/access_name" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/access" />
        </service>
    </application>
</manifest>
